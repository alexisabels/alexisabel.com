---
import Layout from "../layouts/Layout.astro";
import Theme from "../components/Theme.astro";
---

<Layout title="Alejandro Isabel — Página no encontrada">
  <Theme />
  <main
    class="w-full max-w-[1240px] mx-auto flex flex-col items-start justify-center min-h-[75vh]"
  >
    <h1
      class="font-display font-semibold text-ink tracking-tight2 leading-[0.86] text-[clamp(5rem,20vw,13rem)]"
    >
      404
    </h1>

    <p class="mt-6 text-lg md:text-xl text-ink-muted max-w-md">
      Esta página no existe o se ha movido.
    </p>

    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 text-accent hover:underline underline-offset-4"
    >
      <span aria-hidden="true">←</span>
      <span>Volver al inicio</span>
    </a>
  </main>
</Layout>
