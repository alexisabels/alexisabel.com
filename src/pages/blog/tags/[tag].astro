---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostCard from "../../../components/blog/PostCard.astro";

export const prerender = true;

type Post = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const all = await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  const tags: string[] = Array.from(
    new Set(all.flatMap((p: Post) => p.data.tags))
  );
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: all
        .filter((p: Post) => p.data.tags.includes(tag))
        .sort(
          (a: Post, b: Post) =>
            b.data.date.valueOf() - a.data.date.valueOf()
        ),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BlogLayout
  title={`#${tag} · Blog · Alejandro Isabel`}
  description={`Posts etiquetados con ${tag}.`}
>
  <header class="mb-16 md:mb-24">
    <p class="font-mono text-xs uppercase tracking-label text-ink-muted mb-3">
      Tag
    </p>
    <div class="flex items-center gap-3 md:gap-4 mb-6">
      <span
        class="inline-block size-3 md:size-3.5 bg-accent shrink-0 translate-y-[0.55em] md:translate-y-[0.75em]"
        aria-hidden="true"></span>
      <h1
        class="font-display text-ink font-bold tracking-tight2 leading-[0.95] text-[clamp(2.5rem,7vw,5.5rem)]"
      >
        #{tag}
      </h1>
    </div>
    <p class="text-ink-muted">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"} con este tag.
    </p>
  </header>

  <div>
    {
      posts.map((post: Post) => (
        <PostCard
          href={`/blog/${post.slug}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          updated={post.data.updated}
          tags={post.data.tags}
          cover={post.data.cover}
          coverAlt={post.data.coverAlt}
          draft={post.data.draft}
        />
      ))
    }
  </div>
</BlogLayout>
