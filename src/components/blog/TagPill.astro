---
interface Props {
  tag: string;
  active?: boolean;
  class?: string;
}

const { tag, active = false, class: className = "" } = Astro.props;
const href = `/blog/tags/${encodeURIComponent(tag)}`;
---

<a
  href={href}
  class={`inline-flex items-center px-2.5 py-1 text-xs font-mono uppercase tracking-label border transition-colors ${
    active
      ? "border-accent text-accent bg-accent/5"
      : "border-hairline text-ink-muted hover:text-ink hover:border-ink/40"
  } ${className}`}
>
  {tag}
</a>
